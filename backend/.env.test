DB_NAME=negocios_informaticos_pruebas  # <-- APUNTA A LA BD DE PRUEBAS

# ===========================================================
# SEGURIDAD
# ===========================================================
# Se mantienen iguales para que los tokens de prueba sean válidos 
# con la misma configuración de la app, pero podrías cambiarlos si quieres.
JWT_SECRET_KEY=la-verdad-no-se-que-poner-350122
SECRET_KEY=la_verdad_no_es_tan_secreta
ALGORITHM=HS256

ADMIN1_EMAIL=admin@correo.com
ADMIN1_PASSWORD=Admin123*

# ===========================================================
# REDIS (AISLAMIENTO)
# ===========================================================
# Usamos la base de datos 1 de Redis en lugar de la 0.
# Así las pruebas no borran ni contaminan la caché de desarrollo.
REDIS_URL=redis://localhost:6379/1

# ===========================================================
# RATE LIMITING (DESACTIVADO PARA PRUEBAS)
# ===========================================================
# En pruebas, los tests se ejecutan muy rápido. 
# Si dejamos los límites bajos (5 intentos), los tests fallarán 
# aleatoriamente por "Demasiados intentos". Los subimos al máximo.
RATE_LIMIT_DEFAULT=10000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH=10000
RATE_LIMIT_AUTH_WINDOW=60

# ===========================================================
# APIs EXTERNAS (HACIENDA)
# ===========================================================
# ⚠️ REGLA DE ORO: Las pruebas automatizadas NUNCA deben apuntar 
# a URLs de producción. Siempre deben usar las de TEST.
# (En un entorno CI/CD profesional, estas llamadas se "mockean"/simulan, 
# pero tener las URLs de test aquí es el mínimo de seguridad).

HACIENDA_AUTH_URL_TEST=https://apitest.dtes.mh.gob.sv/seguridad/auth
